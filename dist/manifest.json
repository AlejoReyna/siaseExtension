{
  "manifest_version": 3,
  "name": "Oh My SIASE",
  "version": "0.1.0",
  "description": "Un proyecto estudiantil para mejorar la experiencia de usuario de los alumnos de la UANL.",
  "action": {
    "default_title": "Oh My SIASE",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://deimos.dgi.uanl.mx/*",
    "https://api.nexus.uanl.mx/*",
    "https://plataformanexus.uanl.mx/*",
    "https://www.uanl.mx/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/frameset-injector.ts-loader-Bl72Mjqn.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/*default.htm*"
      ],
      "all_frames": false,
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/top-frame.ts-loader-dZlofFIn.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/*maintop.htm*"
      ],
      "css": [
        "src/content/styles/top.css",
        "src/content/styles/notifications.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/left-frame.ts-loader-DwZ4MFxK.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/*mainleftdin01.htm*"
      ],
      "css": [
        "src/content/styles/left.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/center-frame.ts-loader-DAyq68_C.js",
        "assets/profile-card-patch.ts-BoCyLWv3.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/*maincenter.htm*"
      ],
      "css": [
        "src/content/styles/center-v2.css",
        "src/content/styles/notifications.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/service-page.ts-loader-DrRvnP-s.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/eselcarrera.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/deya.sh/ecCargaDocto01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/esCreditoMaterias01.htm*"
      ],
      "css": [
        "src/content/styles/service-pages-v2.css",
        "src/content/styles/notifications.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/receipt-page.ts-loader-Bl3KFPbg.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/ecavpag01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/ecBolRec-v02.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/ecBolRec-v03.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/EgenbolveranoV2.htm*"
      ],
      "css": [
        "src/content/styles/receipt-pages-v2.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/nexus-session-capture.ts-BTN-w_cD.js"
      ],
      "matches": [
        "https://plataformanexus.uanl.mx/*"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/router.ts-loader-CQjHcyKG.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/econcfs01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/echalm01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/control.p*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/econkdx01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/edatal01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/ecohoinsint01.htm*",
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/ecSitEst01.htm*"
      ],
      "css": [
        "src/content/styles/center-v2.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/gym-reservation-page.ts-loader-B0Fssf1Q.js"
      ],
      "matches": [
        "https://deimos.dgi.uanl.mx/cgi-bin/wspd_cgi.sh/CdGymins01.htm*"
      ],
      "css": [
        "src/content/styles/center-v2.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://deimos.dgi.uanl.mx/*"
      ],
      "resources": [
        "src/content/styles/shadow.css",
        "icons/*.png",
        "assets/single-view-layout-BtNc9W3E.js",
        "assets/debug-C4jjSgQw.js",
        "assets/enhancements-DkMg9RFN.js",
        "assets/siase-url-Bw4iX3q2.js",
        "assets/storage-jOxuUkTc.js",
        "assets/frameset-injector.ts-CDc_cnKd.js",
        "assets/student-CtiA_2I8.js",
        "assets/dom-Df3yQYNr.js",
        "assets/top-frame.ts-BuwXpdmx.js",
        "assets/jsx-runtime-xq64MgJl.js",
        "assets/calendar-days-Ct-V_F48.js",
        "assets/left-frame.ts-D81XxdqH.js",
        "assets/center-ui-ChfrDVUE.js",
        "assets/legacy-announcements-C6tCkt5X.js",
        "assets/center-frame.ts-DWZhxEGE.js",
        "assets/profile-card-patch.ts-BoCyLWv3.js",
        "assets/theme-6truD-rp.js",
        "assets/gym-reservation-page.ts-Jhbzqrbd.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://deimos.dgi.uanl.mx/*",
        "https://deimos.dgi.uanl.mx/*",
        "https://deimos.dgi.uanl.mx/*"
      ],
      "resources": [
        "assets/legacy-announcements-C6tCkt5X.js",
        "assets/enhancements-DkMg9RFN.js",
        "assets/storage-jOxuUkTc.js",
        "assets/service-page.ts-D2EtZJSF.js"
      ],
